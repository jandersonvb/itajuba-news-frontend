API_URL=http://localhost:4000/api
SITE_URL=http://localhost:3000
# Mesmo valor de INTERNAL_API_KEY no .env do backend. Nunca use prefixo NEXT_PUBLIC.
INTERNAL_API_KEY=
# Código da meta tag de verificação do Google Search Console (só o valor de content="...").
# GOOGLE_SITE_VERIFICATION=
# Cabeçalho com o IP do visitante, definido pelo proxy do provedor:
# Vercel: x-forwarded-for (padrão; a Vercel o sobrescreve com o IP real) ou x-real-ip
# Railway: x-real-ip · Railway com o proxy do Cloudflare (nuvem laranja): cf-connecting-ip · Render: cf-connecting-ip
# Com cf-connecting-ip, o valor só é aceito quando a conexão veio de um IP do Cloudflare (src/lib/cloudflare-ips.ts).
CLIENT_IP_HEADER=x-forwarded-for
# ID de medição do Google Analytics 4 (G-XXXXXXXXXX). Só em produção; sem ele, não há banner nem GA.
# NEXT_PUBLIC_GA_ID=
